; Engine configuration file.
config_version=5

[application]
config/name="斗破苍穹：焰帝归途"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.04, 0.02, 0.03, 1)
boot_splash/show_image=false

[autoload]
D="*res://scripts/data.gd"
G="*res://scripts/g.gd"
Au="*res://scripts/audio.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.04, 1)

[audio]
buses/default_bus_layout="res://default_bus_layout.tres"

[input_devices]
pointing/emulate_touch_from_mouse=false

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/unused_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
